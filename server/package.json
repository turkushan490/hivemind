{
  "name": "server",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@hivemind/shared=../packages/shared/src/index.ts --outfile=dist/main.js",
    "start": "node dist/main.js",
    "embed:web": "node scripts/embed-web.mjs",
    "embed:bin": "node scripts/embed-bin.mjs",
    "build:exe": "esbuild src/exe.ts --bundle --platform=node --format=esm --target=node22 --alias:@hivemind/shared=../packages/shared/src/index.ts --outfile=dist-exe/hivemind.mjs --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\"",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.4.0"
  },
  "devDependencies": {
    "@hivemind/shared": "*",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.5",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
